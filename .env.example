# iMach — Frontend environment (never commit real .env)
# Copy to .env.local and adjust.

# Base URL of the iMach API (Fastify backend)
# • Same-origin proxy deployment: /api/v1
# • Separate deployment: https://api.imach.example.com/api/v1
NEXT_PUBLIC_API_BASE="/api/v1"

# Sandbox gateway only (Caddy XTransformPort) — leave EMPTY in real deployments.
# When set, every API call appends ?XTransformPort=<port> for the local gateway.
NEXT_PUBLIC_GATEWAY_PORT=""
